# Sao chép thành .env rồi điền. KHÔNG commit file .env.
# Sinh bí mật ngẫu nhiên:  openssl rand -hex 32

# --- Caddy / HTTPS ---
DOMAIN=nt532.example.duckdns.org
ACME_EMAIL=you@example.com

# --- Trạm Raspberry Pi (qua Tailscale) ---
# Lấy IP bằng `tailscale ip -4` trên Pi
NT532_PI_URL=http://<pi-tailscale-ip>:8080

# --- Ứng dụng control ---
# Khóa ký phiên/cookie: openssl rand -hex 32
NT532_SECRET=
NT532_ADMIN_USER=admin
# Băm mật khẩu admin theo định dạng app control yêu cầu (xem homelab/control).
# Nếu hash chứa ký tự $ và compose báo lỗi nội suy, gấp đôi thành $$.
NT532_ADMIN_PASSWORD_HASH=
NT532_DB=/app/data/nt532.db

# --- Token cho máy khách (mỗi cái một chuỗi riêng: openssl rand -hex 32) ---
# Colab worker kết nối WebSocket
NT532_WORKER_TOKEN=
# Bộ ra quyết định (decider)
NT532_DECIDER_TOKEN=

# --- Pi tự đẩy dữ liệu lên VM (Pi khác mạng, sau NAT) ---
# Token Bearer Pi gửi tới /api/pi/push: openssl rand -hex 32 (đặt cùng giá trị ở Pi). Trống = VM tự kéo từ NT532_PI_URL.
NT532_PI_TOKEN=
# Đặt cookie Secure khi chạy sau HTTPS (domain public qua cloudflared)
NT532_HTTPS=true
