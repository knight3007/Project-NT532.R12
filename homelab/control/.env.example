# Sao chép thành .env rồi sửa. Không commit .env.

# Địa chỉ dashboard của Pi (qua Tailscale: http://<tên-máy-pi>:8080 hoặc IP 100.x.y.z)
NT532_PI_URL=http://127.0.0.1:8080

# Khóa ký cookie phiên: chuỗi ngẫu nhiên dài. Tạo bằng: python -c "import secrets; print(secrets.token_urlsafe(32))"
NT532_SECRET=

NT532_ADMIN_USER=admin
# Tạo bằng: uv run python -m app.hash_password
NT532_ADMIN_PASSWORD_HASH=
# Chỉ dùng khi chạy thử, thay cho dòng băm ở trên:
# NT532_ADMIN_PASSWORD=

# Đặt true khi chạy sau HTTPS (Caddy): cookie phiên sẽ có cờ Secure
NT532_HTTPS=false

NT532_DB=data/control.sqlite
NT532_POLL_S=1.0
NT532_RETENTION_DAYS=14
