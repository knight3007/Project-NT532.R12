# Mặc định cho esp32h2. Đặt target bằng `idf.py set-target esp32h2` (tạo sdkconfig, không đưa lên git).
CONFIG_IDF_TARGET="esp32h2"

CONFIG_PARTITION_TABLE_CUSTOM=y
CONFIG_PARTITION_TABLE_CUSTOM_FILENAME="partitions.csv"
CONFIG_PARTITION_TABLE_FILENAME="partitions.csv"
CONFIG_ESPTOOLPY_FLASHSIZE_4MB=y

# Console qua USB-Serial-JTAG của H2 Super Mini
CONFIG_ESP_CONSOLE_USB_SERIAL_JTAG=y

# OpenThread: FTD, radio 802.15.4 gốc của H2, không CLI (CoAP là giao diện duy nhất)
CONFIG_OPENTHREAD_ENABLED=y
CONFIG_OPENTHREAD_FTD=y
CONFIG_OPENTHREAD_RADIO_NATIVE=y
CONFIG_OPENTHREAD_BORDER_ROUTER=n
CONFIG_OPENTHREAD_CLI=n
# SRP client: node đăng ký _nt532._udp với border router (mặc định đã bật, ghi rõ cho chắc)
CONFIG_OPENTHREAD_SRP_CLIENT=y

# mbedTLS như ví dụ ot_cli (OpenThread cần ECJPAKE/DTLS để biên dịch); CoAP của ta không dùng DTLS
CONFIG_MBEDTLS_CMAC_C=y
CONFIG_MBEDTLS_SSL_PROTO_DTLS=y
CONFIG_MBEDTLS_KEY_EXCHANGE_ECJPAKE=y
CONFIG_MBEDTLS_ECJPAKE_C=y

# lwIP: IPv6 qua netif OpenThread, socket UDP cho libcoap
CONFIG_LWIP_IPV6=y
CONFIG_LWIP_IPV6_NUM_ADDRESSES=8
CONFIG_LWIP_TCPIP_TASK_STACK_SIZE=4096
CONFIG_LWIP_HOOK_IP6_SELECT_SRC_ADDR_CUSTOM=y
CONFIG_LWIP_NETBUF_RECVINFO=y

# libcoap (espressif/coap): server + client, tắt DTLS và TCP
CONFIG_COAP_CLIENT_SUPPORT=y
CONFIG_COAP_SERVER_SUPPORT=y
CONFIG_COAP_MBEDTLS_PSK=n
CONFIG_COAP_MBEDTLS_PKI=n
CONFIG_COAP_TCP_SUPPORT=n

# Biên dịch -Os cho cả firmware (mặc định của IDF là -Og để gỡ lỗi): mã nhỏ hơn, chạy từ flash qua cache
# nên ít trượt cache hơn; tải CPU của node rất thấp nên không cần -O2.
CONFIG_COMPILER_OPTIMIZATION_SIZE=y
